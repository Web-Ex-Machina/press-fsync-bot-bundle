<tr class="table-list__line" data-id="<?= $this->id ?>">
	<td class="table-list__cell" data-name="avatar"><img width="50" src="<?= $this->avatar ?>" alt="<?= $this->username ?>" /></td>
	<td class="table-list__cell" data-name="user"><?= $this->username ?></td>
	<td class="table-list__cell" data-name="title"><?= $this->title ?></td>
	<td class="table-list__cell" data-name="category"><?= $this->category_name ?></td>
	<td class="table-list__cell" data-name="date"><?= $this->start_time ?></td>
	<td class="table-list__cell" data-name="duration"><?= $this->duration ?></td>
	<td class="table-list__cell" data-name="actions">
		<a href="<?= $this->url ?>" title="Voir la page de <?= $this->username ?>" target="_blank" class=""><i class="fal fa-eye"></i></a>
	</td>
</tr>